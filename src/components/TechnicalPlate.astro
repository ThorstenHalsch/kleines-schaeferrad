---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'SYSTEMÜBERSICHT / BASISGEOMETRIE',
  subtitle = 'PRÜFBLATT · NICHT MASSHALTIG · BASELINE UNDERSTANDING'
} = Astro.props;
const spokes = Array.from({ length: 6 }, (_, i) => i * 60);
const slots = Array.from({ length: 24 }, (_, i) => i * 15);
---
<figure class="technical-plate">
  <div class="plate-meta">
    <span>KS-00</span>
    <span>BLATT 0 / BASELINE</span>
  </div>
  <svg viewBox="0 0 840 594" role="img" aria-labelledby="plate-title plate-desc">
    <title id="plate-title">Schematische technische Baselinezeichnung des Kleinen Schäferrads</title>
    <desc id="plate-desc">Nicht maßhaltige Prüfzeichnung mit Radkranz, sechs Speichenenden, Achse und erwarteten Umfangspositionen. Alle Maße bleiben offen.</desc>
    <rect x="20" y="20" width="800" height="554" class="plate-frame" />
    <text x="44" y="55" class="plate-heading">{title}</text>
    <text x="44" y="78" class="plate-subheading">{subtitle}</text>

    <g transform="translate(280 305)">
      <circle r="165" class="visible-line" />
      <circle r="145" class="visible-line" />
      <circle r="34" class="visible-line" />
      <line x1="-205" y1="0" x2="205" y2="0" class="axis-line" />
      <line x1="0" y1="-205" x2="0" y2="205" class="axis-line" />
      {spokes.map((angle) => (
        <line x1="0" y1="0" x2="0" y2="-145" class="visible-line" transform={`rotate(${angle})`} />
      ))}
      {slots.map((angle) => (
        <line x1="0" y1="-165" x2="0" y2="-178" class="thin-line" transform={`rotate(${angle})`} />
      ))}
      <text x="-190" y="220" class="plate-note">ANSICHT SCHEMATISCH · KEIN IST-MASS</text>
      <text x="-190" y="240" class="plate-note">24 UMFANGSSLOTS = EXTERN ERWARTET, NICHT 2026 GEZÄHLT</text>
    </g>

    <g transform="translate(520 145)">
      <text x="0" y="0" class="plate-section">BEKANNTE TOPOLOGIE</text>
      <text x="0" y="30" class="plate-note">• WELLE / ACHSE</text>
      <text x="0" y="52" class="plate-note">• 3 DURCHGEHENDE ARME → 6 SPEICHENENDEN</text>
      <text x="0" y="74" class="plate-note">• 2 GETRENNTE KRANZEBENEN</text>
      <text x="0" y="96" class="plate-note">• SEGMENTIERTE KRÜMMLINGE</text>
      <text x="0" y="118" class="plate-note">• KÜMPFE / SCHAUFELN / KEILE / LAGER / TROG</text>
    </g>

    <g transform="translate(520 310)">
      <text x="0" y="0" class="plate-section">NOCH OFFEN</text>
      <text x="0" y="30" class="plate-note">• KRANZEBENENABSTAND</text>
      <text x="0" y="52" class="plate-note">• MORTISEN / EINSTECKTIEFEN</text>
      <text x="0" y="74" class="plate-note">• AKTUELLE UMFANGSFOLGE</text>
      <text x="0" y="96" class="plate-note">• LAGERZENTREN / WASSERLINIE</text>
      <text x="0" y="118" class="plate-note">• REALE 2026-VARIANTEN / REPARATUREN</text>
    </g>

    <g transform="translate(500 470)">
      <rect x="0" y="0" width="300" height="84" class="titlebox" />
      <line x1="0" y1="28" x2="300" y2="28" class="thin-line" />
      <line x1="0" y1="56" x2="300" y2="56" class="thin-line" />
      <line x1="205" y1="28" x2="205" y2="84" class="thin-line" />
      <text x="10" y="19" class="titlebox-strong">KLEINES SCHÄFERRAD · REKONSTRUKTION</text>
      <text x="10" y="46" class="titlebox-text">Zeichnungs-Nr. KS-00 · Rev. B0</text>
      <text x="215" y="46" class="titlebox-text">07.10.2026</text>
      <text x="10" y="74" class="titlebox-text">Maßstab: OHNE · Maße: OFFEN</text>
      <text x="215" y="74" class="titlebox-text">Freigabe: NEIN</text>
    </g>
  </svg>
  <figcaption>Werkstattlesbare Baseline im Stil klassischer Prüfzeichnungen. Die Darstellung ist bewusst nicht maßhaltig und wird erst nach Feldmessung durch echte Zeichnungsblätter ersetzt.</figcaption>
</figure>
