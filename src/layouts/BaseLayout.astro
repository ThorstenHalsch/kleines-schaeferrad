---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { href } from '../lib/paths';
interface Props { title: string; description?: string; }
const { title, description = 'Evidenzbasierte digitale Rekonstruktion des Kleinen Schäferrads bei Möhrendorf/Oberndorf.' } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Kleines Schäferrad</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#193e35" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={`${title} · Kleines Schäferrad`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Direkt zum Inhalt</a>
    <Header />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong class="footer-brand">Kleines Schäferrad.<br />Erfasst, bevor es zerfällt.</strong><p>Eine offene Forschungsansicht zwischen Handwerk, Zeichnung, Fotografie und 3D.</p></div>
        <div><span class="eyebrow">Status</span><p><strong>Baseline Understanding Ready</strong><br />As-built-Geometrie bewusst noch nicht freigegeben.</p></div>
        <div><span class="eyebrow">Repository</span><a class="text-link" href="https://github.com/jdistlr/kleines-schaeferrad">jdistlr/kleines-schaeferrad ↗</a></div>
      </div>
      <div class="container footer-bottom">Research Preview · Stand 07.10.2026 · Keine metrische Rekonstruktion behauptet.</div>
    </footer>
  </body>
</html>
